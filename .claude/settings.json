    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(wrangler d1 execute*)",
      "Bash(npx wrangler d1 execute*)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Edit(./scheda/SCHEMA.md)",
      "Edit(./docs/linee-guida-allenamento.md)"
    ]
  }
