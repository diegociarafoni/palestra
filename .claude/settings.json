{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Edit(./reports/2*.md)",
      "Write(./reports/2*.md)",
      "Edit(./scheda/scheda.*)",
      "Write(./scheda/scheda.*)",
      "Edit(./**/*.sqlite)",
      "Write(./**/*.sqlite)",
      "Edit(./kb/profilo.md)",
      "Write(./kb/profilo.md)",
      "Edit(./package-lock.json)",
      "Write(./package-lock.json)",
      "Bash(npm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git filter-branch*)",
      "Bash(rm -rf*)"
