{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!.superpowers",
      "!!docs/riferimenti",
      "!!**/*.md",
      "!!package-lock.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": { "suspicious": { "noExplicitAny": "error" } }
  }
}
